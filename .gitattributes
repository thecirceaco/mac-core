# Export Ignore (exclude from releases)

/.github            export-ignore
/.github/**         export-ignore
/.codex             export-ignore
/.codex/**          export-ignore
/.vscode            export-ignore
/.vscode/**         export-ignore
/.ddev              export-ignore
/.ddev/**           export-ignore
/.gitignore         export-ignore
/.gitattributes     export-ignore

/README.md          export-ignore
/AGENTS.md          export-ignore
/readme.txt         export-ignore
/composer.json      export-ignore
/composer.lock      export-ignore
/phpcs.xml.dist     export-ignore
/phpunit.xml.dist   export-ignore
/tests              export-ignore
/tests/**           export-ignore
/bin/install-wp-tests.sh export-ignore
/bin/build-dev-zip.ps1 export-ignore

node_modules        export-ignore
node_modules/**     export-ignore
/vendor             export-ignore
/vendor/**          export-ignore
dist                export-ignore
dist/**             export-ignore
coverage            export-ignore
coverage/**         export-ignore
.phpunit.cache      export-ignore
.phpunit.cache/**   export-ignore
.phpunit.result.cache export-ignore
.phpcs-cache        export-ignore

.env                export-ignore
.env.local          export-ignore

.DS_Store           export-ignore
Thumbs.db           export-ignore

# Line Ending Normalization

*                   text=auto

# Force LF for Text Source Files

*.md                text eol=lf
*.mdx               text eol=lf
*.txt               text eol=lf

*.html              text eol=lf
*.css               text eol=lf
*.scss              text eol=lf

*.js                text eol=lf
*.jsx               text eol=lf
*.ts                text eol=lf
*.tsx               text eol=lf

*.php               text eol=lf

*.json              text eol=lf
*.jsonc             text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.xml               text eol=lf

*.ps1               text eol=lf
*.psm1              text eol=lf
*.psd1              text eol=lf
*.sh                text eol=lf
